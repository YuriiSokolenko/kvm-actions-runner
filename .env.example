# Copy to .env, chmod 0600 and use token scoped ONLY to YuriiSokolenko/recursive-coder.
RECURSIVE_CODER_GH_ADMIN_TOKEN=
KVM_MANAGER_IMAGE=n150/recursive-coder-kvm-runner-manager:1.0.0
KVM_GOLDEN_HOST_DIR=/var/lib/recursive-coder-kvm/golden
KVM_STATE_HOST_DIR=/var/lib/recursive-coder-kvm/state
# Existing Pi+General pool reservation. Do not reduce without a separate rollout.
HOST_MAX_EPHEMERAL=12
LEGACY_RESERVED_RUNNERS=11
HOST_MEMORY_RESERVE_MB=3072
