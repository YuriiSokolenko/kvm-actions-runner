FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 MANAGER_CONFIG=/etc/n150/pools.json
WORKDIR /app
COPY n150_runner /app/n150_runner
COPY config/pools.json /etc/n150/pools.json
CMD ["python3", "-m", "n150_runner", "run"]
